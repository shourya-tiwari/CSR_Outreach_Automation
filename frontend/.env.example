# Leave unset for local development - requests go to relative "/api" and
# are handled by the Vite dev server's proxy (see vite.config.js).
#
# Set this in production (e.g. Vercel project settings) to the deployed
# backend's origin, no trailing slash and no "/api" suffix - see
# docs/DEPLOYMENT.md.
# VITE_API_BASE_URL=https://csr-outreach-backend.onrender.com
